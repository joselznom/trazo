{
  "description": "Tell the agent when trazo needs setup or an update (offline, starts no Python)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/plugin/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
