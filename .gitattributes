# Every checkout keeps the repository's LF line endings: the apps install the
# plugin with git, and a Windows git (core.autocrlf) would otherwise write CRLF,
# which changes the template's hashes and the files trazo copies into papers.
* text=auto eol=lf
# cmd.exe misreads batch files with LF line endings.
*.cmd text eol=crlf
# Stored by content hash, so their bytes must stay exactly as written.
packages/trazo/src/trazo/assets/template/blobs/** -text

# Generated by make targets (see AGENTS.md), so scripts/check-file-size.sh skips them:
# a release regenerates them and nobody edits them by hand.
packages/trazo/src/trazo/assets/template/** linguist-generated
template/.agents/skills/** linguist-generated
template/.claude/skills/** linguist-generated
template/figures/external/** linguist-generated

# Grows by one entry per release; its upgrade notes are read by release, not as a whole.
CHANGELOG.md -size-limit
